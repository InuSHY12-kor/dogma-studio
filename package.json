{
  "name": "genecanvas",
  "productName": "GeneCanvas",
  "version": "0.3.0",
  "description": "Desktop plasmid and DNA sequence editor: maps, sequence editing, restriction analysis, features, primers and simulated gels.",
  "main": "main.js",
  "author": "GeneCanvas",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "android:sync": "node tools/stamp-android-version.js && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "test": "node test/run.js",
    "test:desktop": "node test/desktop.js",
    "test:mobile": "node test/mobile.js"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.genecanvas.desktop",
    "productName": "GeneCanvas",
    "copyright": "GeneCanvas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GeneCanvas",
      "artifactName": "GeneCanvas-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GeneCanvas-${version}-portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "gb",
          "gbk",
          "genbank"
        ],
        "name": "GenBank file",
        "description": "GenBank DNA sequence"
      },
      {
        "ext": "dna",
        "name": "DNA sequence file",
        "description": "DNA sequence file"
      },
      {
        "ext": [
          "fa",
          "fasta"
        ],
        "name": "FASTA file",
        "description": "FASTA sequence"
      }
    ]
  }
}
